SECRET_KEY=replace-this-with-a-long-random-secret-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# MySQL Workbench / local MySQL configuration
# Recommended for local development because each database value is easy to edit.
DB_DRIVER=mysql+pymysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=finmark_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# Optional override. If DATABASE_URL has a value, it overrides DB_* above.
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/finmark_db

DATABASE_ECHO=false
SEED_DEMO_DATA=true

# Enterprise scaling settings for 1,000 active users
# For production, use a strong random SECRET_KEY and set APP_ENV=production.
APP_ENV=development
AUTO_CREATE_DB=true
ALLOWED_HOSTS=*
GZIP_MINIMUM_SIZE=1000
THREADPOOL_TOKENS=100
PRODUCT_CACHE_MAX_AGE_SECONDS=60

# SQLAlchemy/MySQL connection pool. Tune these with your DB server max_connections.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10

# Suggested production values after migrations and real seed data are ready:
# APP_ENV=production
# AUTO_CREATE_DB=false
# SEED_DEMO_DATA=false
# FRONTEND_ORIGINS=https://your-domain.com
# ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Microservice deployment settings
# Used by docker-compose.microservices.yml and Kubernetes manifests.
DEPLOYMENT_MODE=single-app
SERVICE_REPLICAS=3
SERVICE_INSTANCE_NAME=local-dev
WEB_CONCURRENCY=2
