# Database configuration style A: separated values for MySQL Workbench
DB_DRIVER=mysql+pymysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=finmark_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# Optional style B: full database URL. If this is present, it overrides DB_* above.
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/finmark_db

# Production pool sizing for multi-worker API deployments
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
AUTO_CREATE_DB=false
SEED_DEMO_DATA=false

# Microservice deployment settings
DEPLOYMENT_MODE=microservices-3-node
SERVICE_REPLICAS=3
SERVICE_INSTANCE_NAME=service-node-name
WEB_CONCURRENCY=2
