+from fastapi import APIRouter, Depends, HTTPException, status
+from fastapi.security import OAuth2PasswordBearer
+
+from ..controllers import auth_controller
+
+router = APIRouter()
+
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="/api/v1/auth/token")
+
+
+async def get_current_user(token: str = Depends(oauth2_scheme)):
+    """
+    Validate the bearer token and return the current user.
+    """
+    user = auth_controller.get_current_user_from_token(token)
+    if not user:
+        raise HTTPException(
+            status_code=status.HTTP_401_UNAUTHORIZED,
+            detail="Invalid or expired access token",
+            headers={"WWW-Authenticate": "Bearer"},
+        )
+
+    return user
+
+
+@router.get("/protected")
+async def read_protected_data(current_user: dict = Depends(get_current_user)):
+    """
+    Retrieves protected data, requiring a valid signed JWT access token.
+    """
+    return {
+        "message": "This is protected data!",
+        "authenticated_user": current_user["username"],
+    }
